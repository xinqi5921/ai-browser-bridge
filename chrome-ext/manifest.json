{
  "manifest_version": 3,
  "name": "AI Browser Bridge",
  "version": "1.0.0",
  "description": "Chrome extension for AI browser automation - bridges AI agents to your real browser",
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"},
  "permissions": ["debugger", "tabs", "storage", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{
    "js": ["content.js"],
    "matches": ["<all_urls>"],
    "run_at": "document_start"
  }],
  "background": {"service_worker": "background.js"},
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Browser Bridge"
  },
  "web_accessible_resources": [{
    "resources": ["icons/*"],
    "matches": ["<all_urls>"]
  }]
}
